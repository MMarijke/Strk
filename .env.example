# Supabase (auth + database)
VITE_SUPABASE_URL=https://bbcfnislakqitekblgro.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_u10PYPvj1wqlvZYNpmHFag_1e6fXnd0

# Paddle Billing — client-side checkout (safe to expose). No fallback default —
# paddle.js throws if VITE_PADDLE_ENVIRONMENT is unset, so this must be set explicitly.
VITE_PADDLE_ENVIRONMENT=sandbox_or_production
VITE_PADDLE_CLIENT_TOKEN=your_token_here
VITE_PADDLE_MONTHLY_PRICE_ID=pri_your_monthly_id_here
VITE_PADDLE_ANNUAL_PRICE_ID=pri_your_annual_id_here

# PostHog analytics
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring (frontend) — from Sentry Dashboard -> Settings ->
# Projects -> [frontend project] -> Client Keys (DSN). Safe to expose
# client-side, same tier as the Paddle client token above. No Session
# Replay, no user PII collection — see src/lib/sentry.js.
VITE_SENTRY_DSN=your_sentry_dsn_here

# --- Edge function secrets (NOT read by the client build — set these via
# `supabase secrets set NAME=value`, never put them in this file for real) ---
# PADDLE_WEBHOOK_SECRET=your_webhook_secret_here — from Paddle Dashboard -> Developer Tools -> Notifications
# PADDLE_API_KEY           — from Paddle Dashboard -> Developer Tools -> Authentication.
#                            Used server-side only (manage-subscription) to call Paddle's API live.
# PADDLE_API_ENVIRONMENT   — "sandbox" or "production". Must match which PADDLE_API_KEY you set —
#                            manage-subscription refuses to start without this set explicitly.
# PADDLE_MONTHLY_PRICE_ID  — same value as VITE_PADDLE_MONTHLY_PRICE_ID above.
#                            Not a secret (already shipped in the client bundle) --
#                            mirrored here so manage-subscription's public,
#                            anonymous get_prices action can allowlist which
#                            prices it's willing to look up for a logged-out
#                            caller, instead of proxying arbitrary Paddle price ids.
# PADDLE_ANNUAL_PRICE_ID   — same value as VITE_PADDLE_ANNUAL_PRICE_ID above, same reason.
# RESEND_API_KEY          — from Resend Dashboard -> API Keys
# RESEND_FROM_ADDRESS     — e.g. "Strk <hello@yourdomain.com>" (domain must be verified in Resend)
# CRON_SECRET             — any random string; also sent as X-Cron-Secret when triggering send-weekly-digest
# UPSTASH_REDIS_REST_URL   — from Upstash Console -> your Redis database -> REST API
# UPSTASH_REDIS_REST_TOKEN — same page as above; used by manage-subscription and
#                            send-welcome-email for per-user rate limiting (no Postgres load)
# SENTRY_DSN               — from Sentry Dashboard -> Settings -> Projects ->
#                             [BACKEND project, a different Sentry project from
#                             the frontend one above] -> Client Keys (DSN)

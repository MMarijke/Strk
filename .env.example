# --- Edge function secrets (NOT read by the client build — set these via
# `supabase secrets set NAME=value`, never put them in this file for real) ---
# PADDLE_WEBHOOK_SECRET=your_webhook_secret_here — from Paddle Dashboard -> Developer Tools -> Notifications
# RESEND_API_KEY          — from Resend Dashboard -> API Keys
# RESEND_FROM_ADDRESS     — e.g. "Strk <hello@yourdomain.com>" (domain must be verified in Resend)
# CRON_SECRET             — any random string; also sent as X-Cron-Secret when triggering send-weekly-digest
